# Production configuration (docs/28 §W9).
#
#   cp .env.production.example .env   and fill in every REQUIRED value.
#
# deploy.sh refuses to start if a required key is missing or still holds a
# development default, because the defaults live in this repository and are
# therefore the ones most likely to reach production by accident.

ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- REQUIRED: secrets ----------
# Generate each with:  openssl rand -hex 32
AUTH_SECRET=
# Salt for hashing IPs in the audit log. Rotating it makes historical addresses
# permanently unlinkable, which is the point of salting them.
AUDIT_IP_SALT=

POSTGRES_USER=visiovox
POSTGRES_PASSWORD=
POSTGRES_DB=visiovox

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=visiovox-media
S3_FORCE_PATH_STYLE=true

# ---------- REQUIRED: public URLs ----------
# The browser-facing API origin. Inlined into the web bundle at BUILD time, so
# changing it needs a rebuild, not a restart.
PUBLIC_API_URL=https://visiovox.example.com
# Where packaged media is served from. Must be reachable by a browser.
PUBLIC_MEDIA_BASE_URL=https://visiovox.example.com/media
# CORS allows exactly this origin, and it is where the refresh cookie is valid.
NEXT_PUBLIC_APP_URL=https://visiovox.example.com

# ---------- Tunnel ----------
# From the Cloudflare Zero Trust dashboard. Only needed with --tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Storage ----------
MEDIA_ROOT=/srv/media
MEDIA_WORK_DIR=/srv/media/work
# On, because this is the machine whose `df /` reports the vhdx's virtual
# maximum rather than real free space.
REQUIRE_DEDICATED_MEDIA_VOLUME=true
DISK_RESERVED_BYTES=21474836480
UPLOAD_PEAK_MULTIPLIER=2.5
MAX_UPLOAD_BYTES=53687091200

# ---------- Pipeline ----------
PIPELINE_MODE=real
# c3, not c2-v2: c2-v2 scores +11.43 dB on VoxCeleb2 but -1.61 dB on the
# product condition, i.e. worse than doing nothing. See config.py.
EXTRACTOR_CHECKPOINT=/home/dmin/runs/c3/best.pt
TORCH_DEVICE=cuda
MEDIA_SANDBOX_IMAGE=visiovox/media-sandbox:1
SPEAKER_EMBEDDER_DIR=/home/dmin/models/ecapa
# pyannote diarization is gated. Without it S2a degrades to VAD only and the
# pipeline falls back to single-speaker handling.
HF_TOKEN=

# ---------- Limits ----------
MAX_DURATION_SECONDS=3600
QUOTA_UPLOADS_PER_DAY=20
QUOTA_MEDIA_SECONDS_PER_MONTH=36000
QUOTA_GPU_SECONDS_PER_MONTH=36000
QUOTA_CONCURRENT_JOBS=2

# ---------- Security ----------
# Behind the tunnel every request arrives from cloudflared, so the real client
# address has to be read from the header it sets. Set this ONLY when such a
# proxy is genuinely in front: with nothing overwriting the header, any caller
# can mint a fresh identity per request and per-IP limiting stops meaning
# anything.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# "lax" requires the app and API to share a registrable domain, which they do
# behind one tunnel. A genuinely cross-site deployment needs "none".
REFRESH_COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
# Redis down allows requests rather than taking the API down with the cache.
RATE_LIMIT_FAIL_OPEN=true
