# Copy to .env.local and fill in. Never commit .env.local.
# See docs/23-runbook.md §2 for setup.

# ---------- Environment ----------
ENVIRONMENT=local                       # local | ci | staging | production
LOG_LEVEL=INFO

# ---------- Web ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# ---------- Auth ----------
AUTH_SECRET=                            # openssl rand -base64 32
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# OIDC (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://visiovox:visiovox@localhost:5432/visiovox

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Object storage (MinIO locally, R2 in production) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=visiovox-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ---------- Pipeline ----------
PIPELINE_MODE=mock                      # mock | real   ← mock needs no GPU
MODEL_CACHE_DIR=./models
EXTRACTOR_VERSION=seave-0.1.0
DEVICE=cuda                             # cuda | cpu
HF_HUB_OFFLINE=0                        # set 1 in production

# Gated model access — see docs/06 §2
HF_TOKEN=                               # required for pyannote 3.x

# ---------- Feature flags ----------
FEATURE_GENERATIVE_RESTORATION=false    # S6 — off until validated (ADR-0005)
FEATURE_LEAKAGE_AUDIT=true              # S8
FEATURE_HLS_ENGINE=true

# ---------- Media volume (docs/track-w/W0) ----------
# Uploads and derived artifacts. MUST be a dedicated filesystem: measuring "/"
# inside the WSL distro returns the vhdx's virtual maximum, not real free space,
# which is how a disk check passes on a full drive.
MEDIA_ROOT=/srv/media
# Bind MinIO's data at the same volume. Leave unset to use the Docker named
# volume, which sits on the distro vhdx.
MEDIA_MINIO_PATH=/srv/media/minio
# Held back from the usable figure; a job needs source, working copy and outputs
# on disk at once.
DISK_RESERVED_BYTES=21474836480         # 20 GB
# Peak disk a job occupies relative to its source. Provisional until measured.
UPLOAD_PEAK_MULTIPLIER=2.5
# Off locally and in CI, which legitimately have no separate volume. Set true on
# the deployed workstation.
REQUIRE_DEDICATED_MEDIA_VOLUME=false

# ---------- Limits ----------
# A backstop against one absurd upload, NOT the limit shown to users - that is
# computed from live headroom (docs/28 D2).
MAX_UPLOAD_BYTES=53687091200            # 50 GB
MAX_DURATION_SECONDS=3600               # 60 min
MAX_SPEAKERS=4

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=visiovox-api
SENTRY_DSN=

# ---------- Email ----------
SMTP_HOST=localhost
SMTP_PORT=1025                          # mailhog
EMAIL_FROM=noreply@visiovox.local
