# ---------- ML artifacts ----------
# Weights are versioned in the model registry, never in git
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
!**/testdata/**/*.pt

# Datasets live on the compute machine, never in git
data/
datasets/
!data/.gitkeep

# Experiment tracking
wandb/
mlruns/

# Downloaded pretrained weights — re-fetchable, never committed.
# Anchored with a leading slash: a bare `models/` matches at every depth, which
# silently swallowed `ml/models/` — the SEAVE backbone and the conditioning
# module — so the core of the project was never committed and nobody noticed,
# because an ignored file does not show up in `git status`. Same failure as the
# TypeScript one in 0ce84bb; anchor these patterns unless they are meant to be
# recursive.
/models/
lightning_logs/
/runs/
/outputs/
checkpoints/
!checkpoints/.gitkeep

# Evaluation outputs
eval/results/
eval/history.jsonl
*.parquet
!**/testdata/**/*.parquet

# ---------- Media ----------
# Fixtures are tracked via Git LFS (see .gitattributes); everything else is not
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.aac
# MPEG-TS segments live under HLS output directories. A bare *.ts here
# also ignores every TypeScript source file in the repo, which silently
# dropped the generated API client from three commits before it was
# noticed. Scope it to where segments actually are.
**/hls/**/*.ts
**/segments/**/*.ts
*.m3u8
!tests/fixtures/**
!apps/web/public/demo/**

# ---------- Infrastructure ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
kubeconfig
*.kubeconfig

# ---------- Local services ----------
.docker-data/
postgres-data/
redis-data/
minio-data/

# ---------- Editors / OS ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Scratch ----------
scratch/
tmp/
*.log

# Player demo fixtures — generated by scripts/make_player_fixtures.py.
# Derived from Libri3Mix, so they rebuild from the dataset rather than living
# in the repository; about two minutes on CPU.
/apps/web/public/fixtures/

# Playwright run artefacts
/test-results/
/playwright-report/
/blob-report/
