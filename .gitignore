# ---------- ML artifacts ----------
# Weights are versioned in the model registry, never in git
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
!**/testdata/**/*.pt

# Datasets live on the compute machine, never in git
data/
datasets/
!data/.gitkeep

# Experiment tracking
wandb/
mlruns/

# Downloaded pretrained weights — re-fetchable, never committed
models/
lightning_logs/
runs/
outputs/
checkpoints/
!checkpoints/.gitkeep

# Evaluation outputs
eval/results/
eval/history.jsonl
*.parquet
!**/testdata/**/*.parquet

# ---------- Media ----------
# Fixtures are tracked via Git LFS (see .gitattributes); everything else is not
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.ts
*.m3u8
!tests/fixtures/**
!apps/web/public/demo/**

# ---------- Infrastructure ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
kubeconfig
*.kubeconfig

# ---------- Local services ----------
